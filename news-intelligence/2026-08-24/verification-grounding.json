    {
      "segment": {
        "startIndex": 171,
        "endIndex": 564,
        "text": "#### **[1] Anthropic’s flagship AI model struggles to attract corporate users amid cheaper alternatives**\n* **Confirmed:** Reporting by the *Financial Times* (citing corporate billing data from payment platform Ramp covering ~70,000 businesses) shows that enterprise spending on Anthropic’s top-tier model, **Fable 5**, has plateaued at approximately 11% of total outlay on Anthropic tools"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 566,
        "endIndex": 712,
