{
  "name": "sapiver-forge-daily-ai-brief-builder",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Sapiver Forge automated daily AI news research, validation, evergreen learning, audience-fit optimisation, media and distribution system.",
  "scripts": {
    "daily": "bash scripts/run-fresh-daily-with-event-retry.sh",
    "angle:alternate": "node src/reangle-daily.mjs",
    "draft": "node src/generate-daily-brief.mjs",
    "novelty:event": "node src/check-event-novelty.mjs",
    "social:optimise": "node src/optimise-social-audience-fit.mjs",
    "feature": "node src/generate-full-feature.mjs",
    "evergreen": "node src/generate-evergreen-explainer.mjs",
    "podcast:daily": "node src/generate-daily-podcast-script.mjs",
    "verify:claims": "node src/verify-material-claims.mjs",
    "repair:claims": "node src/repair-material-claims.mjs",
    "podcast:archive": "node scripts/archive-old-editions.mjs",
    "opportunity:weekly": "node src/generate-weekly-opportunity.mjs",
    "newsletter:weekly": "node src/generate-weekly-newsletter.mjs",
    "validate:auto": "bash scripts/validate-with-report.sh",
    "media:ai": "node src/generate-ai-media.mjs",
    "syndicate:dev": "node src/post-feature-to-dev.mjs",
    "export:approved": "node src/export-approved-bundle.mjs",
    "build:site": "node scripts/build-sapiver-forge-site.mjs && node src/build-evergreen-guides.mjs && node scripts/hide-podcast-rss-link.mjs && npm run build:publishing",
    "release:desk": "node src/build-release-desk.mjs",
    "release:approve": "node src/approve-release.mjs",
    "review:human": "node src/build-human-review-package.mjs",
    "review:email": "node src/send-human-review-email.mjs",
    "release:human": "node src/approve-human-candidate.mjs",
    "check": "node src/check-approval.mjs",
    "test:validation-system": "node test/validation-system.mjs",
    "build:publishing": "node src/build-publishing-dashboard.mjs",
    "test:gemini": "node test/gemini-provider-contract.mjs"
  },
  "dependencies": {
    "openai": "latest"
  },
  "devDependencies": {}
