#!/usr/bin/env bash
set -u

if [ "${1:-}" = "apt-get" ]; then
  shift
  if [ "${1:-}" = "update" ] || { [ "${1:-}" = "install" ] && printf '%s\n' "$*" | grep -q "ffmpeg"; }; then
    /usr/bin/sudo /usr/bin/apt-get "$@" || {
      echo "Optional FFmpeg installation failed; text outputs and human review will continue."
      exit 0
    }
    exit 0
  fi
fi

exec /usr/bin/sudo "$@"
